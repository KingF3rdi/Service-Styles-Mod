{
  "schemaVersion": 1,
  "id": "hugoservice",
  "version": "${version}",
  "name": "${product_name}",
  "description": "Mix single objects (crystal, anchor, totem, ...) from texture packs and save them as a new pack. Open with Right Shift. Vanilla Minecraft font.",
  "authors": ["${product_author}"],
  "license": "MIT",
  "icon": "assets/hugoservice/icon.png",
  "environment": "client",
  "entrypoints": { "client": ["dev.hugoservice.HugoService"] },
  "mixins": ["hugoservice.mixins.json", "hugoservice-extra.mixins.json"],
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "${minecraft_dep}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
